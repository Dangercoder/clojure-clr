<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Features>$(Features);runtime-async=on</Features>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="clojure.core.specs.alpha" Version="0.4.74" />
    <PackageReference Include="DynamicLanguageRuntime" Version="1.3.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Clojure/Clojure/Clojure.csproj" />
    <ProjectReference Include="../../Clojure/Clojure.Source/Clojure.Source.csproj" />
  </ItemGroup>

  <!-- Copy Clojure source files to output so (require) can find them -->
  <ItemGroup>
    <Content Include="app/**/*.clj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
